#!/usr/bin/env python3
"""Install LED Service for Linux Voice Assistant.

Usage:
    sudo python3 setup [options]

Options:
    --socket PATH       Socket path (default: /run/lva/led.sock)
    --n NUM             Number of LEDs (default: 12)
    --brightness NUM    LED brightness 0-31 (default: 8)
    --user NAME         System user running PulseAudio (for audio VU meter)
    --uninstall         Remove the service
"""

import argparse
import os
import shutil
import subprocess
import sys
import venv
from pathlib import Path

_DIR = Path(__file__).parent.resolve()
_VENV_DIR = _DIR / ".venv"
_LED_SERVICE = _DIR / "led-service.py"

SERVICE_NAME = "lva-led"
SERVICE_FILE = Path(f"/etc/systemd/system/{SERVICE_NAME}.service")


def check_root():
    """Ensure script is run as root."""
    if os.geteuid() != 0:
        print("Error: This script must be run as root (sudo)", file=sys.stderr)
        sys.exit(1)


def setup_venv():
    """Create virtual environment and install dependencies."""
    print(f"Creating virtual environment: {_VENV_DIR}")

    builder = venv.EnvBuilder(with_pip=True)
    builder.create(_VENV_DIR)
    context = builder.ensure_directories(_VENV_DIR)

    pip = [context.env_exe, "-m", "pip"]
    subprocess.check_call(pip + ["install", "--upgrade", "--quiet", "pip"])
    subprocess.check_call(pip + ["install", "--quiet", "spidev"])

    print("Dependencies installed: spidev")
    return context.env_exe


def get_pulse_server(user: str) -> str:
    """Detect PulseAudio socket path for the given user."""
    try:
        uid = subprocess.check_output(["id", "-u", user], text=True).strip()
        pulse_path = f"unix:/run/user/{uid}/pulse/native"
        print(f"PulseAudio server for '{user}' (uid {uid}): {pulse_path}")
        return pulse_path
    except (subprocess.CalledProcessError, FileNotFoundError):
        print(f"Warning: could not determine UID for user '{user}', "
              "audio VU meter may not work", file=sys.stderr)
        return None


def install(socket_path: str, n: int, brightness: int, pulse_user: str = None):
    """Install the LED service."""
    if not _LED_SERVICE.exists():
        print(f"Error: {_LED_SERVICE} not found", file=sys.stderr)
        sys.exit(1)

    venv_python = setup_venv()

    # Detect PulseAudio user: explicit --user, or the user who ran sudo
    if not pulse_user:
        pulse_user = os.environ.get("SUDO_USER")
    if not pulse_user:
        print("Warning: could not detect PulseAudio user (no --user, no SUDO_USER), "
              "audio VU meter may not work", file=sys.stderr)

    # Build optional PulseAudio environment line
    env_line = ""
    if pulse_user:
        pulse_server = get_pulse_server(pulse_user)
        if pulse_server:
            env_line = f"Environment=PULSE_SERVER={pulse_server}"

    env_section = f"\n{env_line}" if env_line else ""
    service_content = f"""[Unit]
Description=LED Service for Linux Voice Assistant
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory={_DIR}{env_section}
ExecStartPre=/bin/mkdir -p {Path(socket_path).parent}
ExecStart={venv_python} {_LED_SERVICE} {socket_path} --n {n} --brightness {brightness}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
"""

    SERVICE_FILE.write_text(service_content)
    print(f"Created: {SERVICE_FILE}")

    subprocess.check_call(["systemctl", "daemon-reload"])
    subprocess.check_call(["systemctl", "enable", SERVICE_NAME])
    subprocess.check_call(["systemctl", "restart", SERVICE_NAME])

    print(f"\nService '{SERVICE_NAME}' installed and started!")
    print(f"Socket: {socket_path}")
    print(f"\nCommands:")
    print(f"  systemctl status {SERVICE_NAME}")
    print(f"  journalctl -u {SERVICE_NAME} -f")
    print(f"\nTo use with linux-voice-assistant:")
    print(f"  python3 -m linux_voice_assistant --name 'Name' --event-socket {socket_path}")


def uninstall():
    """Remove the LED service."""
    subprocess.run(["systemctl", "stop", SERVICE_NAME], check=False)
    subprocess.run(["systemctl", "disable", SERVICE_NAME], check=False)

    if SERVICE_FILE.exists():
        SERVICE_FILE.unlink()
        print(f"Removed: {SERVICE_FILE}")

    if _VENV_DIR.exists():
        shutil.rmtree(_VENV_DIR)
        print(f"Removed: {_VENV_DIR}")

    subprocess.check_call(["systemctl", "daemon-reload"])
    print(f"\nService '{SERVICE_NAME}' uninstalled!")


def main():
    parser = argparse.ArgumentParser(description="Install LED Service for Linux Voice Assistant")
    parser.add_argument("--socket", default="/run/lva/led.sock", help="Socket path")
    parser.add_argument("--n", type=int, default=3, help="Number of LEDs")
    parser.add_argument("--brightness", type=int, default=8, help="LED brightness 0-31")
    parser.add_argument("--user", default=None,
                        help="System user running PulseAudio (e.g. hass) for audio VU meter")
    parser.add_argument("--uninstall", action="store_true", help="Remove the service")
    args = parser.parse_args()

    check_root()

    if args.uninstall:
        uninstall()
    else:
        install(args.socket, args.n, args.brightness, args.user)


if __name__ == "__main__":
    main()
