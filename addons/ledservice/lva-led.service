[Unit]
Description=LED Service for Linux Voice Assistant
After=network.target

[Service]
Type=simple
User=root
ExecStartPre=/bin/mkdir -p /run/lva
ExecStart=/usr/bin/python3 /opt/linux-voice-assistant/addons/led-service.py /run/lva/led.sock --n 12 --brightness 8
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
